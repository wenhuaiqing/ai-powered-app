# ---- LLM + embeddings ------------------------------------------------
# Default provider is "openai": any endpoint speaking the OpenAI
# protocol. The deployed demo points at Azure OpenAI's /openai/v1
# surface. LLM_CHAT_MODEL / LLM_EMBED_MODEL are *deployment* names on
# Azure (chat deployment `gpt-4-1-mini` backs model gpt-4.1-mini
# 2025-04-14); on stock OpenAI they are plain model ids.
LLM_PROVIDER=openai
EMBED_PROVIDER=openai
LLM_BASE_URL=
LLM_API_KEY=
LLM_CHAT_MODEL=gpt-4-1-mini
LLM_EMBED_MODEL=text-embedding-3-small

# Legacy AWS Bedrock path -- set both providers to "bedrock" to use it.
# Needs AWS creds on PATH (`aws configure`) + Bedrock model access in
# the target region. NOTE: Titan v2 is 1024-D against
# text-embedding-3-small's 1536-D, so switching means rebuilding the RAG
# parquets (build_regulation_corpus.py + build_review_embeddings.py).
AWS_REGION=ap-southeast-2
BEDROCK_CHAT_MODEL=au.anthropic.claude-sonnet-4-6
BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0

# ---- Artefact store (trained model + RAG parquets) --------------------
# Azure: public-read blob container base URL, e.g.
#   https://<account>.blob.core.windows.net/artefacts
# The backend downloads on boot when the files are missing locally.
# Local dev can leave both empty -- the scripts read/write data/ on disk.
ARTEFACT_BASE_URL=
S3_ARTEFACT_BUCKET=

# Tavily web search (free tier: 1000/month)
TAVILY_API_KEY=

# Local paths (defaults match the repo layout -- usually leave alone)
DATA_DIR=./data
MODEL_PATH=./data/model.pkl
DUCKDB_PATH=./data/platform.duckdb

# MySQL (OLTP). Defaults match docker-compose.yml -- `docker compose up -d mysql`.
# In the Azure deploy these come from Key Vault via the container app's
# managed identity; nothing is baked into the image.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_DATABASE=reapit_demo

# CORS
CORS_ORIGINS=http://localhost:5173
